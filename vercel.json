{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/js/:path*", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/lib/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/rpt/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
